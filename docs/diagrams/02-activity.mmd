flowchart LR
    start((Начало)) --> select["Пользователь выбирает фотографию"]
    select --> valid{"Формат JPG/PNG<br/>и размер до 10 МиБ?"}
    valid -->|"Нет"| validationError["Приложение показывает ошибку файла"]
    validationError --> finish((Конец))
    valid -->|"Да"| upload["Приложение сохраняет фотографию<br/>и создаёт анализ в состоянии processing"]
    upload --> ml["Приложение передаёт фотографию ML-сервису"]
    ml --> success{"Обработка успешна?"}
    success -->|"Нет"| failed["Приложение переводит анализ в failed<br/>и показывает сообщение об ошибке"]
    failed --> finish
    success -->|"Да"| completed["Приложение сохраняет тип кожи<br/>и переводит анализ в completed"]
    completed --> result["Пользователь получает результат,<br/>рекомендации и ингредиенты"]
    result --> finish
